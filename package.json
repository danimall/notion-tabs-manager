{
  "name": "notion-tabs-manager",
  "version": "1.0.0",
  "description": "Menu bar app to capture and manage Notion desktop tabs",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac"
  },
  "dependencies": {
    "menubar": "^9.4.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.notion-tabs-manager",
    "productName": "Notion Tabs Manager",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "icons/icon.icns"
    }
  }
}
